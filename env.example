# Copy to .env.local (git ignores it) and fill in. Never commit real values.

# Postgres. Local: postgres://seating:seating@127.0.0.1:5432/seating_dev
# On Vercel the Neon integration sets DATABASE_URL and DATABASE_URL_UNPOOLED.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Only used once, by /setup, to create the first account. It can go once that
# account exists.
SITE_PASSWORD=

# On Vercel (production and preview deployments alike): the email the first
# account (made at /setup) must use. Setup on any Vercel deployment refuses any
# other email, and refuses to run without this. Local runs take any email.
BOOTSTRAP_ADMIN_EMAIL=

# Signs the session and share cookies. At least 32 characters. Make one with: openssl rand -base64 32
AUTH_SECRET=

# Floor plan import (milestone 7). Server only.
ANTHROPIC_API_KEY=
# Optional: the model the import uses. Leave blank for the default.
FLOORPLAN_MODEL=

# Nightly backups (vercel.json crons -> /api/cron/backups). Vercel sends this
# secret with every cron call. At least 32 letters and digits:
# openssl rand -hex 32. Production builds fail without it.
CRON_SECRET=
# Local runs and e2e only: where stored backups go on this machine. Leave it
# out on Vercel, where a private Blob store connected to Production holds
# them (it adds BLOB_STORE_ID). Without either, backups are not set up.
BACKUP_STORE_DIR=.backups
# Optional: how many AI floor plan imports each planner may start in any 30
# days (each one costs a few cents on the key above). Default 10; 0 lets only
# admins import. Admins are never capped.
AI_IMPORT_MONTHLY_LIMIT=
