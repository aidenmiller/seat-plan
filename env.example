# Copy to .env.local (git ignores it) and fill in. Never commit real values.
# Production settings live in Vercel, not in a file. README.md says which.

# --- Database ---
# Postgres. Local: postgres://seating:seating@127.0.0.1:5432/seating_dev. Required.
DATABASE_URL=
# Direct (not pooled) connection that migrations and the seed use first. On Vercel the Neon integration sets both.
DATABASE_URL_UNPOOLED=

# --- Sign-in ---
# Signs the session and share link cookies and keys the sign-in throttle: at least 32 characters (openssl rand -base64 32). Required. Changing it signs out every share link viewer.
AUTH_SECRET=

# --- First-run setup (/setup) ---
# The old shared password. Used once, by /setup, to make the first account; nothing reads it after that, so it can go.
SITE_PASSWORD=
# On Vercel (production and previews): the email the first account must use. /setup refuses to run without it there. Local runs take any email.
BOOTSTRAP_ADMIN_EMAIL=

# --- Nightly backups (vercel.json cron -> /api/cron/backups) ---
# The secret Vercel sends with each cron call: 32 or more letters and digits only (openssl rand -hex 32). Production builds fail without it.
CRON_SECRET=
# Local runs only: a folder to keep stored backups in. Leave it out on Vercel, where a private Blob store connected to Production holds them. Without either, backups are off.
BACKUP_STORE_DIR=.backups
# Vercel sets this when a Blob store is connected to Production; do not set it yourself. (A BLOB_READ_WRITE_TOKEN also works, but the connection's OIDC sign-in needs no token.)
BLOB_STORE_ID=

# --- Floor plan import ---
# Anthropic API key for the AI floor plan import. Server only. Without it the import says the key is missing and everything else works.
ANTHROPIC_API_KEY=
# Optional: the model the import uses. Leave blank for the default.
FLOORPLAN_MODEL=
# Optional: AI imports each planner may start in any 30 days (each costs a few cents). Default 10; 0 lets only admins import; admins are never capped.
AI_IMPORT_MONTHLY_LIMIT=

# --- Set by Vercel (not here) ---
# VERCEL, VERCEL_ENV: which deployment this is. Migrations and the Blob store are used only when VERCEL_ENV is production.

# --- Tests (optional; each has a local default) ---
# Database for npm test. Local only: tests refuse any other host. Default postgres://seating:seating@127.0.0.1:5432/seating_test
# TEST_DATABASE_URL=
# Database for npm run e2e. Default postgres://seating:seating@127.0.0.1:5432/seating_e2e
# E2E_DATABASE_URL=
# A suffix such as _b picks a second set of test databases made by: npx tsx scripts/create-test-dbs.ts b
# TEST_DB_SUFFIX=
# Port the e2e run's production server and the stand-in Anthropic API listen on (defaults 3100 and 4210).
# E2E_PORT=
# E2E_STAND_IN_PORT=
# Set to 1 to reuse the last build in npm run e2e.
# E2E_SKIP_BUILD=
