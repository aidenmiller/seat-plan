    "idb-keyval": "6.3.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "next": "16.4.5",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "svg2pdf.js": "2.9.0",
