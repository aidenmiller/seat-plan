    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "6.2.8",
    "pdf-lib": "1.17.1",
    "tailwindcss": "4.3.5",
