    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "seed:perf": "tsx --conditions=react-server scripts/seed-perf.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "pdfjs:wasm": "tsx scripts/copy-pdfjs-wasm.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@node-rs/argon2": "2.2.2",
    "@vercel/functions": "3.11.0",
